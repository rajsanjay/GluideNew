# Test Mode Configuration
# Copy this file to .env when running in TEST MODE
# Uses synthetic fixture data instead of real databases

# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings_test
DJANGO_SECRET_KEY=test-mode-secret-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Test Mode Settings
USE_TEST_MODE=True
GENERATE_FIXTURES=True

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database - SQLite (automatically configured in settings_test.py)
# No database configuration needed - using SQLite

# Redis - Local memory cache in test mode
# No Redis needed - using Django's local memory cache

# Celery - Eager mode (synchronous for testing)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True

# External Services - Disabled in test mode
PINECONE_API_KEY=test-mode-disabled
MEILISEARCH_HOST=test-mode-disabled
OPENAI_API_KEY=test-mode-disabled
USE_S3=False

# Note: Test mode uses synthetic data from fixtures/
# Run: python manage.py loaddata api/fixtures/*.json
