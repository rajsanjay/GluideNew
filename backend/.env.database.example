# Database Mode Configuration
# Copy this file to .env when running in DATABASE MODE
# Connects to EXISTING PostgreSQL databases and external services

# Django Configuration
DJANGO_SETTINGS_MODULE=config.settings_database
DJANGO_SECRET_KEY=your-production-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Mode Settings
USE_TEST_MODE=False

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# Primary Database (EXISTING PostgreSQL - gluide_me)
POSTGRES_DB=gluide_me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=your_existing_primary_db_host
POSTGRES_PORT=5432

# Course Database (EXISTING PostgreSQL - course_db)
DB_DATABASE=course_db
DB_USER=postgres
DB_PASSWORD=your_course_db_password
DB_HOST=your_existing_course_db_host
DB_PORT=5432

# Redis Configuration (EXISTING Redis instance)
REDIS_HOST=your_existing_redis_host
REDIS_PORT=6379
REDIS_URL=redis://your_existing_redis_host:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://your_existing_redis_host:6379/0
CELERY_RESULT_BACKEND=redis://your_existing_redis_host:6379/0

# AWS S3 Configuration (EXISTING S3 bucket)
USE_S3=True
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_existing_bucket_name
AWS_S3_REGION_NAME=us-east-1

# Pinecone Configuration (EXISTING)
PINECONE_API_KEY=your_existing_pinecone_api_key
PINECONE_ENVIRONMENT=your_existing_pinecone_environment
PINECONE_INDEX_NAME=your_existing_pinecone_index

# Meilisearch Configuration (EXISTING)
MEILISEARCH_HOST=your_existing_meilisearch_host
MEILISEARCH_API_KEY=your_existing_meilisearch_api_key

# OpenAI Configuration (EXISTING)
OPENAI_API_KEY=your_existing_openai_api_key

# IMPORTANT: Replace all placeholder values with your actual credentials
# DO NOT commit the .env file to version control
