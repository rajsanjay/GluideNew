# Test Mode Frontend Configuration
# Copy this to .env.local when running in test mode

# API Configuration (Test Mode Backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_TEST_MODE=true

# App Configuration
NEXT_PUBLIC_APP_NAME=Gluide (Test Mode)
NODE_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
